# 会商阶段服务：与 execution-v1 同一应用入口（function_task=risk_consultation）。
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml requirements.txt MANIFEST.in README.md LICENSE ./
COPY flowagent ./flowagent
COPY services ./services
COPY run_execution.py ./
RUN pip install --no-cache-dir \
    --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    ".[api]"

ENV PYTHONIOENCODING=utf-8 \
    FRAMEWORK_AUTH_ENABLED=0 \
    WORKFLOW_HOST=0.0.0.0 \
    WORKFLOW_PORT=8080
EXPOSE 8080
CMD ["python", "run_execution.py"]
