{"id": "flt-model-empty", "kind": "fault", "fault": {"position": "model", "type": "empty_response"}, "expect_target": {"behavior": "recover_once_then_fallback", "error_code": "MODEL_INVALID_RESPONSE"}, "expect_baseline": {"behavior": "runtime_error_after_one_retry"}, "note": "A07：未发布正文且未执行工具时最多恢复一次"}
{"id": "flt-model-invalid-json", "kind": "fault", "fault": {"position": "model", "type": "invalid_tool_json"}, "expect_target": {"behavior": "no_partial_execution", "error_code": "MODEL_INVALID_RESPONSE"}, "note": "A05：非法批次零部分执行，修正受额度限制"}
{"id": "flt-mcp-error", "kind": "fault", "fault": {"position": "mcp", "type": "is_error"}, "expect_target": {"behavior": "tool_error_fed_back"}, "note": "A08：isError 与超时、unknown 区分"}
{"id": "flt-mcp-invalid-args", "kind": "fault", "fault": {"position": "mcp", "type": "invalid_arguments_on_code_params"}, "expect_target": {"behavior": "direct_fallback", "error_code": "TOOL_ARGUMENT_INVALID"}, "note": "A08：代码定参被服务拒绝直接交兜底，不让模型改参"}
{"id": "flt-skill-load-failed", "kind": "fault", "fault": {"position": "skill", "type": "load_denied"}, "expect_target": {"behavior": "tool_error_fed_back"}, "note": "F01 范围；SkillLoadError 软化为工具错误反馈"}
{"id": "flt-deadline", "kind": "fault", "fault": {"position": "budget", "type": "main_deadline"}, "expect_target": {"behavior": "stop_main_then_fallback_once"}, "note": "G05/B03：主阶段硬超时停止后唯一一次直连"}
{"id": "flt-cancel", "kind": "fault", "fault": {"position": "budget", "type": "user_cancel"}, "expect_target": {"behavior": "stop_no_fallback", "status": "cancelled"}, "note": "F04：取消后零新调用，不继续兜底"}
{"id": "flt-duplicate-tool", "kind": "fault", "fault": {"position": "model", "type": "duplicate_effective_call"}, "expect_target": {"behavior": "terminate_before_second_io", "error_code": "DUPLICATE_TOOL_CALL"}, "note": "A09：同工具相同有效参数第二次调用前终止"}
{"id": "flt-output-invalid", "kind": "fault", "fault": {"position": "output", "type": "schema_violation_after_repair"}, "expect_target": {"behavior": "fallback_once"}, "note": "H02：格式修复一次耗尽后交错误边界"}
{"id": "flt-write-unknown-no-replay", "kind": "fault", "fault": {"position": "mcp", "type": "write_unknown_then_main_fail"}, "expect_target": {"behavior": "no_write_replay"}, "note": "F03：写工具已执行/unknown 后兜底不重放写操作"}
